{
  "name": "@brand/brand",
  "version": "1.0.0",
  "description": "Glyph brand theme. Rename this package before the first commit.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
